@model StokWeb.Controllers.DatabaseTestModel
@{
    ViewData["Title"] = "Veritabanı Test";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Veritabanı Test</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="fa fa-database me-2"></i>Veritabanı Bağlantı Testi</h4>
                    </div>
                    <div class="card-body">
                        
                        <!-- Bağlantı Durumu -->
                        <div class="mb-4">
                            <h5>Bağlantı Durumu:</h5>
                            <div class="alert @(Model.ConnectionStatus.Contains("✅") ? "alert-success" : "alert-danger")">
                                @Model.ConnectionStatus
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.DatabaseVersion))
                        {
                                <div class="mb-4">
                                    <h5>Veritabanı Versiyonu:</h5>
                                    <p class="text-muted">@Model.DatabaseVersion</p>
                                </div>
                        }

                        <!-- Tablo Durumları -->
                        @if (Model.TableStatus.Any())
                        {
                                <div class="mb-4">
                                    <h5>Tablo Durumları:</h5>
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Tablo Adı</th>
                                                    <th>Durum</th>
                                                    <th>Kayıt Sayısı</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var table in Model.TableStatus)
                                                {
                                                        <tr>
                                                            <td><code>@table.Key</code></td>
                                                            <td>@table.Value</td>
                                                            <td>
                                                                @if (Model.TableCounts.ContainsKey(table.Key))
                                                                {
                                                                        <span class="badge bg-info">@Model.TableCounts[table.Key].ToString("N0")</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                        }

                        <!-- Hata Detayları -->
                        @if (!string.IsNullOrEmpty(Model.ErrorDetails))
                        {
                                <div class="mb-4">
                                    <h5>Hata Detayları:</h5>
                                    <div class="alert alert-warning">
                                        <details>
                                            <summary>Detaylı hata mesajı için tıklayın</summary>
                                            <pre class="mt-2 small">@Model.ErrorDetails</pre>
                                        </details>
                                    </div>
                                </div>
                        }

                        <!-- Geri Dön Butonu -->
                        <div class="text-center">
                            <a href="/" class="btn btn-secondary">
                                <i class="fa fa-home me-2"></i>Ana Sayfaya Dön
                            </a>
                            <button onclick="location.reload()" class="btn btn-primary">
                                <i class="fa fa-refresh me-2"></i>Tekrar Test Et
                            </button>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>