@using System.Data
@using System.Linq
@model DataTable

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Personel Yönetimi";
    string secili = ViewBag.Secili as string ?? "T";
    int sayfaNo = ViewBag.SayfaNo ?? 1;
    int toplamSayfa = ViewBag.ToplamSayfa ?? 1;
}

<!-- 🎨 PREMIUM PERSONNEL PAGE STYLES -->
<style>
    /* 🎯 ANIMATIONS */
    .fade-in {
        animation: fadeIn 0.8s ease-out;
    }

    .fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .stagger-1 {
        animation-delay: 0.1s;
    }

    .stagger-2 {
        animation-delay: 0.2s;
    }

    .stagger-3 {
        animation-delay: 0.3s;
    }

    @@keyframes fadeIn
    {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes fadeInUp
        {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* 👥 TEAM HEADER */
            .team-header {
                background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
                border-radius: 20px;
                padding: 2.5rem;
                color: white;
                margin-bottom: 2rem;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            }

            /* 🎛️ CONTROLS */
            .controls-container {
                background: #fff;
                border-radius: 20px;
                padding: 1.5rem;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
                margin-bottom: 2rem;
            }

            /* 👤 USER TABLE */
            .user-table {
                background: #fff;
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            }

            .user-table thead th {
                background: #343a40;
                color: white;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border-bottom: 3px solid #007bff;
                padding: 15px;
            }

            .user-table tbody tr {
                transition: all 0.3s ease;
            }

            .user-table tbody tr:hover {
                background-color: #f8f9fa;
                transform: scale(1.02);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
                z-index: 10;
                position: relative;
            }

            .user-table tbody td {
                padding: 15px;
                vertical-align: middle;
            }

            .user-badge {
                padding: 8px 12px;
                border-radius: 25px;
                font-weight: 700;
                font-size: 0.8em;
            }

            .badge-admin {
                background: linear-gradient(135deg, #dc3545, #c82333);
                color: white;
            }

            .badge-personnel {
                background: linear-gradient(135deg, #6c757d, #5a6268);
                color: white;
            }

            /* 🎪 ACTION BUTTONS */
            .action-buttons a {
                margin: 0 4px;
                transition: transform 0.2s ease;
            }

            .action-buttons a:hover {
                transform: scale(1.2);
            }

            /* 📄 PAGINATION */
            .pagination .page-item .page-link {
                border-radius: 50% !important;
                width: 40px;
                height: 40px;
                display: flex;
                justify-content: center;
                align-items: center;
                margin: 0 5px;
                transition: all 0.3s ease;
            }

            .pagination .page-item.active .page-link {
                background-color: #007bff;
                border-color: #007bff;
                transform: scale(1.1);
                box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
            }
        </style>

        <div class="container-fluid">
            <div id="messageArea"></div>

            <!-- 👥 TEAM HEADER -->
            <div class="team-header fade-in">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="display-5 fw-bold mb-2">👥 Personel Yönetimi</h1>
                        <p class="lead mb-0 opacity-90">Kullanıcıları yönetin, yetkileri düzenleyin.</p>
                    </div>
                    <i class="fas fa-users-cog fa-4x opacity-75"></i>
                </div>
            </div>

            <!-- 🎛️ CONTROLS -->
            <div class="controls-container d-flex justify-content-between align-items-center flex-wrap fade-in-up stagger-1">
                <form asp-action="Index" method="get" class="d-flex align-items-center gap-3">
                    <input type="hidden" name="sayfa" value="1" />
                    <label class="fw-bold text-primary">Yetkiye Göre Filtrele:</label>
                    <select name="yetki" class="form-select w-auto" onchange="this.form.submit()">
                        @Html.Raw($"<option value='T' {(secili == "T" ? "selected" : "")}>Hepsi</option>")
                        @Html.Raw($"<option value='Admin' {(secili == "Admin" ? "selected" : "")}>Admin</option>")
                        @Html.Raw($"<option value='Personel' {(secili == "Personel" ? "selected" : "")}>Personel</option>")
                    </select>
                </form>
                <div class="d-flex gap-2 mt-2 mt-md-0">
                    <button class="btn btn-outline-success" onclick="exportPersonelCsv('@secili')">
                        <i class="fas fa-file-csv me-2"></i>CSV İndir
                    </button>
                    <a class="btn btn-primary" asp-action="Yeni">
                        <i class="fas fa-plus me-2"></i>Yeni Kullanıcı Ekle
                    </a>
                </div>
            </div>

            <!-- 👤 USER TABLE -->
            <div class="user-table fade-in-up stagger-2">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th><i class="fas fa-id-badge me-2"></i>ID</th>
                                <th><i class="fas fa-user me-2"></i>Kullanıcı Adı</th>
                                <th><i class="fas fa-shield-alt me-2"></i>Yetki</th>
                                <th class="text-center"><i class="fas fa-cogs me-2"></i>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Rows.Count > 0)
                            {
                                foreach (DataRow row in Model.Rows)
                                {
                                    <tr>
                                        <td><span class="badge bg-primary fs-6">@row["ID"]</span></td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-user-circle fa-2x me-3 text-secondary"></i>
                                                <div>
                                                    <strong class="text-dark">@row["KULLANICI_ADI"]</strong>
                                                    <br><small class="text-muted">Sistem Kullanıcısı</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span
                                                class="user-badge @(row["YETKI"].ToString() == "Admin" ? "badge-admin" : "badge-personnel")">
                                                @row["YETKI"]
                                            </span>
                                        </td>
                                        <td class="text-center action-buttons">
                                            <a class="btn btn-sm btn-outline-info" asp-action="Log" asp-route-id="@row["ID"]"
                                                title="Kullanıcı Logları"><i class="fas fa-eye"></i></a>
                                            <a class="btn btn-sm btn-outline-warning" asp-action="Guncelle" asp-route-id="@row["ID"]"
                                                title="Güncelle"><i class="fas fa-edit"></i></a>
                                            <a class="btn btn-sm btn-outline-danger" asp-action="Sil" asp-route-id="@row["ID"]"
                                                onclick="return confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz?')"
                                                title="Sil"><i class="fas fa-trash"></i></a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <i class="fas fa-users-slash fa-4x text-muted mb-3"></i>
                                        <h4>Kayıtlı Kullanıcı Bulunamadı</h4>
                                        <p class="text-muted">Filtre kriterlerine uygun kullanıcı bulunmuyor.</p>
                                        <a class="btn btn-primary mt-2" asp-action="Yeni"><i class="fas fa-plus me-2"></i>İlk
                                            Kullanıcıyı Ekle</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 📄 MODERN PAGINATION -->
            @if (toplamSayfa > 1)
            {
                <div class="pagination-container" data-total-pages="@toplamSayfa">
                    <nav>
                        <ul class="pagination">
                            @if (sayfaNo > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?yetki=@secili&sayfa=@(sayfaNo - 1)" aria-label="Önceki">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            
                            @{
                                int startPage = Math.Max(1, sayfaNo - 2);
                                int endPage = Math.Min(toplamSayfa, sayfaNo + 2);
                                
                                if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?yetki=@secili&sayfa=1">1</a>
                                    </li>
                                    if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="pagination-ellipsis">...</span>
                                        </li>
                                    }
                                }
                                
                                for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == sayfaNo ? "active" : "")">
                                        <a class="page-link" href="?yetki=@secili&sayfa=@i">@i</a>
                                    </li>
                                }
                                
                                if (endPage < toplamSayfa)
                                {
                                    if (endPage < toplamSayfa - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="pagination-ellipsis">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="?yetki=@secili&sayfa=@toplamSayfa">@toplamSayfa</a>
                                    </li>
                                }
                            }
                            
                            @if (sayfaNo < toplamSayfa)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?yetki=@secili&sayfa=@(sayfaNo + 1)" aria-label="Sonraki">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                    <div class="pagination-info">
                        <small class="text-muted">📄 Sayfa @sayfaNo / @toplamSayfa</small>
                    </div>
                </div>
            }
        </div>

        @section Scripts {
            <script>
                function exportPersonelCsv(yetki) {
                    const btn = event.target;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>İndiriliyor...';
                    btn.disabled = true;

                    fetch(`@Url.Action("ExportPersonelCsv", "AdminPersonel")?yetki=${yetki}`)
                        .then(response => {
                            if (response.ok) return response.blob();
                            throw new Error('CSV dışa aktarma başarısız oldu.');
                        })
                        .then(blob => {
                            const url = window.URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.style.display = 'none';
                            a.href = url;
                            a.download = 'kullanicilar.csv';
                            document.body.appendChild(a);
                            a.click();
                            window.URL.revokeObjectURL(url);
                            showNotification('✅ Kullanıcı listesi başarıyla indirildi!', 'success');
                        })
                        .catch(error => showNotification('❌ ' + error.message, 'error'))
                        .finally(() => {
                            btn.innerHTML = '<i class="fas fa-file-csv me-2"></i>CSV İndir';
                            btn.disabled = false;
                        });
                }
            </script>
        }
