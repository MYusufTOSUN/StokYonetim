<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StokWeb</title>

    <!-- ✅ Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- ✅ Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- ✅ Feather Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/feather-icons@4.29.0/dist/feather.min.css">

    <!-- ✅ DattaAble Template Styles -->
    <link rel="stylesheet" href="~/css/dattaable-style.css" />
</head>

<body>
    <div class="pcoded-wrapper">

        <!-- ✅ SIDEBAR -->
        <nav class="pcoded-navbar">
            <div class="navbar-wrapper">
                <!-- Logo Section -->
                <div class="navbar-brand p-4 text-center border-bottom">
                    <h4 class="text-primary mb-0">StokWeb</h4>
                    <small class="text-muted">Yönetim Paneli</small>
                </div>

                <!-- Navigation Menu -->
                <ul class="nav pcoded-inner-navbar">
                    <li><a asp-controller="Home" asp-action="Index"><i data-feather="home"></i> Dashboard</a></li>
                    <li><a asp-controller="Siparis" asp-action="Index"><i data-feather="shopping-cart"></i>
                            Siparişler</a></li>
                    <li><a asp-controller="Cari" asp-action="Index"><i data-feather="users"></i> Müşteriler</a></li>
                    <li><a asp-controller="Stok" asp-action="Index"><i data-feather="package"></i> Ürünler</a></li>
                    <li><a asp-controller="AdminAnaliz" asp-action="Index"><i data-feather="bar-chart-2"></i> Analiz &
                            Raporlar</a></li>
                    <li class="nav-divider">
                        <div class="dropdown-divider my-3"></div>
                    </li>
                    <li><a asp-controller="Ayarlar" asp-action="Index"><i data-feather="settings"></i> Ayarlar</a></li>
                    <li><a asp-controller="Giris" asp-action="Index" class="text-danger"><i data-feather="log-out"></i>
                            Çıkış Yap</a></li>
                </ul>
            </div>
        </nav>

        <!-- ✅ HEADER -->
        <header class="navbar pcoded-header navbar-expand-lg navbar-light header-dark">
            <div class="d-flex align-items-center w-100">
                <!-- Mobile Menu Toggle -->
                <button class="navbar-toggler d-lg-none me-3" type="button" id="mobile-menu-toggle">
                    <i data-feather="menu"></i>
                </button>

                <!-- Search Bar -->
                <div class="flex-grow-1 me-4">
                    <div class="search-box" style="max-width: 400px;">
                        <div class="input-group">
                            <input type="text" class="form-control bg-transparent border-0 text-white"
                                placeholder="Arama yapın..." style="background: rgba(255,255,255,0.1) !important;">
                            <span class="input-group-text bg-transparent border-0">
                                <i data-feather="search" class="text-white"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Header Actions -->
                <div class="ms-auto">
                    <ul class="navbar-nav flex-row">
                        <!-- Notifications -->
                        <li class="nav-item dropdown me-2">
                            <a class="nav-link position-relative" href="#" data-bs-toggle="dropdown">
                                <i data-feather="bell" class="text-white"></i>
                                <span
                                    class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                    style="font-size: 10px;">
                                    3
                                </span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <h6 class="dropdown-header">Bildirimler</h6>
                                <a class="dropdown-item" href="#">
                                    <i data-feather="alert-circle" class="me-2 text-warning"></i>
                                    Düşük stok uyarısı
                                </a>
                                <a class="dropdown-item" href="#">
                                    <i data-feather="shopping-cart" class="me-2 text-success"></i>
                                    Yeni sipariş alındı
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-center" href="#">Tümünü Görüntüle</a>
                            </div>
                        </li>

                        <!-- User Profile -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" data-bs-toggle="dropdown">
                                <div
                                    class="avatar-sm rounded-circle bg-light me-2 d-flex align-items-center justify-content-center">
                                    <i data-feather="user" class="text-dark" style="width: 16px; height: 16px;"></i>
                                </div>
                                <span class="text-white d-none d-md-inline">Admin</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <div class="dropdown-header">
                                    <h6 class="mb-0">Admin Kullanıcı</h6>
                                    <small class="text-muted">admin@stokweb.com</small>
                                </div>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" asp-controller="AdminPersonel" asp-action="Profile">
                                    <i data-feather="user" class="me-2"></i>Profil
                                </a>
                                <a class="dropdown-item" asp-controller="Ayarlar" asp-action="Index">
                                    <i data-feather="settings" class="me-2"></i>Ayarlar
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" asp-controller="Giris" asp-action="Index">
                                    <i data-feather="log-out" class="me-2"></i>Çıkış Yap
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- ✅ SAYFA İÇERİĞİ -->
        <div class="pcoded-main-container">
            <div class="pcoded-content p-4">
                @RenderBody()
            </div>
        </div>

    </div>

    <!-- ✅ Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ✅ Feather Icons JS -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.29.0/dist/feather.min.js"></script>

    <!-- ✅ DattaAble Core JS -->
    <script src="~/js/dattaable-core.js"></script>

    <!-- ✅ Initialize Icons -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            feather.replace();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
