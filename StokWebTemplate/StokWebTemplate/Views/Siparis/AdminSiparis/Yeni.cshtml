@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Yeni Sipariş";
}

<!-- 🎨 PREMIUM FORM STYLES -->
<style>
    /* 🎯 ANIMATIONS */
    .fade-in { animation: fadeIn 0.8s ease-out; }
    .fade-in-up { animation: fadeInUp 0.8s ease-out; }
    .slide-in { animation: slideIn 0.6s ease-out; }
    
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes slideIn { from { opacity: 0; transform: translateX(-30px); } to { opacity: 1; transform: translateX(0); } }
    
    /* 📝 FORM STYLES */
    .form-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 2rem;
        color: white;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    .form-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 15px;
        padding: 2rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .form-control-modern {
        border-radius: 12px;
        border: 2px solid rgba(102, 126, 234, 0.3);
        padding: 12px 15px;
        transition: all 0.3s ease;
        background: rgba(255, 255, 255, 0.9);
    }
    
    .form-control-modern:focus {
        border-color: #667eea;
        box-shadow: 0 0 20px rgba(102, 126, 234, 0.3);
        transform: scale(1.02);
    }
    
    .form-label-modern {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }
    
    .btn-animated {
        border-radius: 12px;
        padding: 12px 24px;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    
    .btn-animated:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
    
    .btn-animated::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.5s;
    }
    
    .btn-animated:hover::before { left: 100%; }
    
    .new-stock-fields {
        display: none;
        animation: slideIn 0.5s ease-out;
    }
    
    .new-stock-fields.show {
        display: block;
    }
    
    /* 🎯 STAGGER DELAYS */
    .stagger-1 { animation-delay: 0.1s; }
    .stagger-2 { animation-delay: 0.2s; }
    .stagger-3 { animation-delay: 0.3s; }
    
    /* 📱 RESPONSIVE */
    @@media (max-width: 768px) {
        .form-container { padding: 1.5rem; }
        .form-card { padding: 1.5rem; }
    }
</style>

<div class="container-fluid">
    <!-- 📝 FORM HEADER -->
    <div class="form-container fade-in">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-2">📝 Yeni Sipariş</h1>
                <p class="lead mb-0 opacity-90">Yeni sipariş bilgilerini girin</p>
            </div>
            <div class="col-md-4 text-end">
                <i class="fas fa-plus-circle fa-3x opacity-75"></i>
            </div>
        </div>
    </div>

    <!-- 📋 FORM CARD -->
    <div class="form-card fade-in-up stagger-1">
        <form asp-action="Yeni" method="post" id="siparisForm">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label-modern">🏢 Cari Seç</label>
                        @Html.DropDownList("CARI_ID", (SelectList)ViewBag.Cariler, "Seçiniz", new { @class = "form-control form-control-modern", required = "required" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label-modern">📦 Stok Seç</label>
                        <select name="STOK_ID" id="stokSelect" class="form-control form-control-modern" required>
                            <option value="">Seçiniz</option>
                            @if (ViewBag.Stoklar != null)
                            {
                                foreach (var item in (SelectList)ViewBag.Stoklar)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                            <option value="NEW">➕ Yeni Stok Ekle</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- 🆕 YENİ STOK ALANLARI -->
            <div class="new-stock-fields" id="newStockFields">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label-modern">📦 Stok Adı</label>
                            <input type="text" name="NEW_STOK_AD" id="newStokAd" class="form-control form-control-modern" placeholder="Stok adını girin" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label-modern">🏷️ Özel Kod</label>
                            <input type="text" name="NEW_OZEL_KOD" id="newOzelKod" class="form-control form-control-modern" placeholder="Özel kod girin" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label-modern">⚖️ Birim</label>
                        <input type="text" name="BIRIM" class="form-control form-control-modern" placeholder="Birim (kg, adet, vb.)" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label-modern">📊 Miktar</label>
                        <input type="number" step="0.01" name="MIKTAR" class="form-control form-control-modern" placeholder="Miktar girin" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label-modern">🔄 Sipariş Türü</label>
                        <select class="form-control form-control-modern" name="SIPARIS_TUR" required>
                            <option value="">Seçiniz</option>
                            <option value="A">📥 Alım</option>
                            <option value="V">📤 Satım</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label-modern">📅 Tarih</label>
                        <input type="date" name="SIPARIS_TARIHI" class="form-control form-control-modern" required />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success btn-animated">
                    <i class="fas fa-save me-2"></i>Siparişi Kaydet
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-animated">
                    <i class="fas fa-arrow-left me-2"></i>Vazgeç
                </a>
            </div>
        </form>
    </div>
</div>

<!-- 🚀 JAVASCRIPT -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const stokSelect = document.getElementById('stokSelect');
        const newStockFields = document.getElementById('newStockFields');
        const newStokAd = document.getElementById('newStokAd');
        const newOzelKod = document.getElementById('newOzelKod');
        
        // Stok seçimi değiştiğinde
        stokSelect.addEventListener('change', function() {
            if (this.value === 'NEW') {
                newStockFields.classList.add('show');
                newStokAd.required = true;
                newOzelKod.required = true;
            } else {
                newStockFields.classList.remove('show');
                newStokAd.required = false;
                newOzelKod.required = false;
            }
        });
        
        // Form submit kontrolü
        document.getElementById('siparisForm').addEventListener('submit', function(e) {
            if (stokSelect.value === 'NEW') {
                if (!newStokAd.value.trim() || !newOzelKod.value.trim()) {
                    e.preventDefault();
                    alert('Yeni stok için stok adı ve özel kod gereklidir!');
                    return false;
                }
            }
        });
        
        // Form validation animations
        const inputs = document.querySelectorAll('.form-control-modern');
        inputs.forEach(input => {
            input.addEventListener('blur', function() {
                if (this.validity.valid) {
                    this.style.borderColor = '#10b981';
                } else {
                    this.style.borderColor = '#ef4444';
                }
            });
            
            input.addEventListener('input', function() {
                if (this.validity.valid) {
                    this.style.borderColor = '#667eea';
                }
            });
        });
    });
</script>