@using System.Data
@using System.Linq
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Analiz Paneli";
    var enCokStoklar = ViewBag.EnCokStoklar as DataTable;
    var zamanSiparis = ViewBag.ZamanSiparis as DataTable;
    var turDagilimi = ViewBag.TurDagilimi as DataTable;
}

<!-- 🎨 PREMIUM ANALYSIS PAGE STYLES -->
<style>
    /* 🎯 ANIMATIONS */
    .fade-in {
        animation: fadeIn 0.8s ease-out;
    }

    .fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .counter-up {
        animation: counterUp 1.5s ease-out;
    }

    @@keyframes fadeIn
    {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes fadeInUp
        {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes counterUp {
                    from {
                        transform: translateY(15px);
                        letter-spacing: 0.2em;
                        opacity: 0;
                    }

                    to {
                        transform: translateY(0);
                        letter-spacing: normal;
                        opacity: 1;
                    }
                }

                @@keyframes pulse {

                        0%,
                        100% {
                            transform: scale(1);
                        }

                        50% {
                            transform: scale(1.05);
                        }
                    }

                    /* 📊 ANALYSIS HEADER */
                    .analysis-header {
                        background: linear-gradient(135deg, #434343 0%, #000000 100%);
                        border-radius: 20px;
                        padding: 2rem;
                        color: white;
                        margin-bottom: 1.5rem;
                        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
                    }

                    /* 📈 STATS CARDS */
                    .stat-card {
                        background-color: #fff;
                        border-radius: 20px;
                        padding: 1.5rem;
                        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
                        text-align: center;
                        opacity: 0;
                        /* For animation */
                        position: relative;
                        overflow: hidden;
                    }

                    .stat-card:hover {
                        transform: translateY(-5px);
                        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
                    }

                    .stat-card::before {
                        content: '';
                        position: absolute;
                        top: 0;
                        left: -100%;
                        width: 100%;
                        height: 100%;
                        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                        transition: left 0.5s;
                    }

                    .stat-card:hover::before {
                        left: 100%;
                    }

                    .stat-icon {
                        font-size: 2.5rem;
                        margin-bottom: 1rem;
                        display: block;
                    }

                    .stat-card-primary {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        color: white;
                    }

                    .stat-card-success {
                        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
                        color: white;
                    }

                    .stat-card-danger {
                        background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
                        color: white;
                    }

                    .stat-card-info {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        color: white;
                    }

                    .stat-card-warning {
                        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
                        color: white;
                    }

                    /* 📊 CHART CONTAINERS */
                    .chart-container {
                        background: #fff;
                        border-radius: 20px;
                        padding: 1.5rem;
                        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
                        margin-bottom: 1.5rem;
                        height: 350px; /* Fixed height for charts */
                        overflow: hidden;
                    }

                    .chart-container h5 {
                        margin-bottom: 1rem;
                        color: #333;
                        font-weight: 600;
                    }

                    /* 🎯 STAGGER DELAYS */
                    .stagger-1 { animation-delay: 0.1s; }
                    .stagger-2 { animation-delay: 0.2s; }
                    .stagger-3 { animation-delay: 0.3s; }
                    .stagger-4 { animation-delay: 0.4s; }
                    .stagger-5 { animation-delay: 0.5s; }
                    .stagger-6 { animation-delay: 0.6s; }

                    /* 📱 RESPONSIVE */
                    @@media (max-width: 768px) {
                        .analysis-header { padding: 1.5rem; }
                        .stat-card { padding: 1rem; }
                        .chart-container { height: 300px; padding: 1rem; }
                    }
                </style>

                <div class="container-fluid">
                    <!-- 📊 ANALYSIS HEADER -->
                    <div class="analysis-header fade-in">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h1 class="display-5 fw-bold mb-2">📊 Analiz Paneli</h1>
                                <p class="lead mb-0 opacity-90">Stok ve sipariş verilerinizi analiz edin</p>
                            </div>
                            <div class="col-md-4 text-end">
                                <i class="fas fa-chart-line fa-4x opacity-75"></i>
                            </div>
                        </div>
                    </div>

                    <!-- 📈 STATS CARDS -->
                    <div class="row mb-4">
                        <div class="col-xl col-md-4 col-sm-6 mb-3">
                            <div class="stat-card fade-in-up stagger-1 stat-card-primary"><i class="fas fa-box-open stat-icon"></i>
                                <h6>Toplam Sipariş</h6>
                                <h3 class="counter">@ViewBag.ToplamSiparis</h3>
                            </div>
                        </div>
                        <div class="col-xl col-md-4 col-sm-6 mb-3">
                            <div class="stat-card fade-in-up stagger-2 stat-card-success"><i
                                    class="fas fa-arrow-circle-down stat-icon"></i>
                                <h6>Toplam Alınan</h6>
                                <h3 class="counter">@ViewBag.ToplamAlim</h3>
                            </div>
                        </div>
                        <div class="col-xl col-md-4 col-sm-6 mb-3">
                            <div class="stat-card fade-in-up stagger-3 stat-card-danger"><i
                                    class="fas fa-arrow-circle-up stat-icon"></i>
                                <h6>Toplam Verilen</h6>
                                <h3 class="counter">@ViewBag.ToplamVerilen</h3>
                            </div>
                        </div>
                        <div class="col-xl col-md-6 col-sm-6 mb-3">
                            <div class="stat-card fade-in-up stagger-4 stat-card-info"><i class="fas fa-users stat-icon"></i>
                                <h6>Cari Sayısı</h6>
                                <h3 class="counter">@ViewBag.ToplamCari</h3>
                            </div>
                        </div>
                        <div class="col-xl col-md-6 col-sm-6 mb-3">
                            <div class="stat-card fade-in-up stagger-5 stat-card-warning"><i class="fas fa-cubes stat-icon"></i>
                                <h6>Stok Sayısı</h6>
                                <h3 class="counter">@ViewBag.ToplamStok</h3>
                            </div>
                        </div>
                    </div>

                    <!-- 📊 CHARTS -->
                    <div class="row">
                        <div class="col-lg-7 mb-3">
                            <div class="chart-container fade-in-up stagger-6">
                                <h5>📦 En Çok Sipariş Alan 10 Stok</h5>
                                <canvas id="barChart"></canvas>
                            </div>
                        </div>
                        <div class="col-lg-5 mb-3">
                            <div class="chart-container fade-in-up stagger-6">
                                <h5>⚖️ Alınan & Verilen Sipariş Dağılımı</h5>
                                <canvas id="pieChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="chart-container fade-in-up stagger-6">
                                <h5>📅 Son 6 Aylık Sipariş Trendi</h5>
                                <canvas id="lineChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                @section Scripts {
                    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
                    <script>
                        document.addEventListener("DOMContentLoaded", function () {

                            // Counter Animation
                            const counters = document.querySelectorAll('.counter');
                            counters.forEach(counter => {
                                const target = +counter.innerText;
                                counter.innerText = '0';
                                const speed = 200;

                                const updateCount = () => {
                                    const count = +counter.innerText;
                                    const inc = target / speed;

                                    if (count < target) {
                                        counter.innerText = Math.ceil(count + inc);
                                        setTimeout(updateCount, 1);
                                    } else {
                                        counter.innerText = target.toLocaleString('tr-TR');
                                    }
                                };
                                updateCount();
                            });

                            // Chart Defaults
                            Chart.defaults.font.family = "'Poppins', sans-serif";
                            Chart.defaults.plugins.legend.position = 'bottom';
                            Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(0, 0, 0, 0.7)';
                            Chart.defaults.plugins.tooltip.titleFont = { size: 14, weight: 'bold' };
                            Chart.defaults.plugins.tooltip.bodyFont = { size: 12 };
                            Chart.defaults.plugins.tooltip.padding = 10;
                            Chart.defaults.plugins.tooltip.cornerRadius = 10;

                            const premiumColors = ['#667eea', '#764ba2', '#f7797d', '#fbd786', '#34e89e', '#00c6ff', '#a8e063', '#a1c4fd', '#ffecd2', '#fbc2eb'];

                            // Bar Chart - Top Stocks
                            const barCtx = document.getElementById('barChart')?.getContext('2d');
                            if (barCtx) {
                                const barLabels = @Html.Raw( Newtonsoft.Json.JsonConvert.SerializeObject(enCokStoklar?.Rows.Cast<DataRow>().Select(r => r["STOK_AD"].ToString()).ToList() ?? new List<string>()) );
                                const barData = @Html.Raw( Newtonsoft.Json.JsonConvert.SerializeObject(enCokStoklar?.Rows.Cast<DataRow>().Select(r => Convert.ToDecimal(r["TOPLAM"])).ToList() ?? new List<decimal>()) );

                                new Chart(barCtx, {
                                    type: 'bar',
                                    data: {
                                        labels: barLabels,
                                        datasets: [{
                                            label: 'Toplam Sipariş Miktarı',
                                            data: barData,
                                            backgroundColor: premiumColors,
                                            borderColor: premiumColors.map(c => c + 'B3'),
                                            borderWidth: 1,
                                            borderRadius: 5
                                        }]
                                    },
                                    options: { 
                                        maintainAspectRatio: false,
                                        responsive: true,
                                        plugins: {
                                            legend: {
                                                display: false
                                            }
                                        },
                                        scales: {
                                            y: {
                                                beginAtZero: true,
                                                ticks: {
                                                    font: {
                                                        size: 10
                                                    }
                                                }
                                            },
                                            x: {
                                                ticks: {
                                                    font: {
                                                        size: 10
                                                    }
                                                }
                                            }
                                        }
                                    }
                                });
                            }

                            // Pie Chart - Order Type Distribution
                            const pieCtx = document.getElementById('pieChart')?.getContext('2d');
                            if (pieCtx) {
                                const pieLabels = @Html.Raw( Newtonsoft.Json.JsonConvert.SerializeObject(turDagilimi?.Rows.Cast<DataRow>().Select(r => r["SIPARIS_TUR"].ToString() == "A" ? "Alınan" : "Verilen").ToList() ?? new List<string>()) );
                                const pieData = @Html.Raw( Newtonsoft.Json.JsonConvert.SerializeObject(turDagilimi?.Rows.Cast<DataRow>().Select(r => Convert.ToInt32(r["ADET"])).ToList() ?? new List<int>()) );

                                new Chart(pieCtx, {
                                    type: 'doughnut',
                                    data: {
                                        labels: pieLabels,
                                        datasets: [{
                                            data: pieData,
                                            backgroundColor: ['#34d399', '#f87171'],
                                            hoverOffset: 4,
                                            borderWidth: 0
                                        }]
                                    },
                                    options: { 
                                        maintainAspectRatio: false, 
                                        cutout: '65%',
                                        plugins: {
                                            legend: {
                                                position: 'bottom',
                                                labels: {
                                                    font: {
                                                        size: 12
                                                    }
                                                }
                                            }
                                        }
                                    }
                                });
                            }

                            // Line Chart - Monthly Order Trend
                            const lineCtx = document.getElementById('lineChart')?.getContext('2d');
                            if (lineCtx) {
                                const lineLabels = @Html.Raw( Newtonsoft.Json.JsonConvert.SerializeObject(zamanSiparis?.Rows.Cast<DataRow>().Select(r => r["AY"].ToString()).ToList() ?? new List<string>()) );
                                const lineData = @Html.Raw( Newtonsoft.Json.JsonConvert.SerializeObject(zamanSiparis?.Rows.Cast<DataRow>().Select(r => Convert.ToInt32(r["ADET"])).ToList() ?? new List<int>()) );

                                const gradient = lineCtx.createLinearGradient(0, 0, 0, 400);
                                gradient.addColorStop(0, 'rgba(102, 126, 234, 0.5)');
                                gradient.addColorStop(1, 'rgba(118, 75, 162, 0)');

                                new Chart(lineCtx, {
                                    type: 'line',
                                    data: {
                                        labels: lineLabels,
                                        datasets: [{
                                            label: 'Sipariş Adeti',
                                            data: lineData,
                                            borderColor: '#667eea',
                                            backgroundColor: gradient,
                                            fill: true,
                                            tension: 0.4,
                                            pointBackgroundColor: '#fff',
                                            pointBorderColor: '#667eea',
                                            pointHoverRadius: 7,
                                            pointHoverBackgroundColor: '#667eea',
                                            pointRadius: 5,
                                        }]
                                    },
                                    options: { 
                                        maintainAspectRatio: false,
                                        plugins: {
                                            legend: {
                                                display: false
                                            }
                                        },
                                        scales: {
                                            y: {
                                                beginAtZero: true,
                                                ticks: {
                                                    font: {
                                                        size: 10
                                                    }
                                                }
                                            },
                                            x: {
                                                ticks: {
                                                    font: {
                                                        size: 10
                                                    }
                                                }
                                            }
                                        }
                                    }
                                });
                            }
                        });
                    </script>
                }
