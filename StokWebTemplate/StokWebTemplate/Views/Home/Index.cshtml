    </div>

    <div class="col-lg-6 col-md-12 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Hızlı İşlemler</h5>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-sm-6 col-12 mb-2">
                        <a asp-controller="Siparis" asp-action="Create"
                            class="btn btn-outline-primary w-100 mobile-action-btn">
                            <i data-feather="plus-circle" class="me-2"></i>Yeni Sipariş
                        </a>
                    </div>
                    <div class="col-sm-6 col-12 mb-2">
                        <a asp-controller="Stok" asp-action="Create"
                            class="btn btn-outline-success w-100 mobile-action-btn">
                            <i data-feather="package" class="me-2"></i>Ürün Ekle
                        </a>
                    </div>
                    <div class="col-sm-6 col-12 mb-2">
                        <a asp-controller="Cari" asp-action="Create"
                            class="btn btn-outline-warning w-100 mobile-action-btn">
                            <i data-feather="user-plus" class="me-2"></i>Müşteri Ekle
                        </a>
                    </div>
                    <div class="col-sm-6 col-12 mb-2">
                        <a asp-controller="AdminAnaliz" asp-action="Index"
