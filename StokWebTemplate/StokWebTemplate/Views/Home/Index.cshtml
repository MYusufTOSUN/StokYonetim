                    </div>
                    <div class="flex-grow-1 ms-4">
                        <h4 class="premium-stat-number mb-1" data-target="342">0</h4>
                        <p class="premium-stat-label mb-0">Aktif Sipariş</p>
                        <div class="premium-stat-trend">
                            <i data-feather="trending-up" class="trend-icon text-success"></i>
                            <span class="trend-text">+8.2%</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer premium-card-footer">
                <small class="text-muted">Bu hafta</small>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
        <div class="card premium-stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="premium-icon-wrapper bg-gradient-warning">
                            <i data-feather="users" class="premium-icon"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-4">
                        <h4 class="premium-stat-number mb-1" data-target="1258">0</h4>
                        <p class="premium-stat-label mb-0">Müşteri</p>
                        <div class="premium-stat-trend">
                            <i data-feather="trending-up" class="trend-icon text-success"></i>
                            <span class="trend-text">+5.7%</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer premium-card-footer">
                <small class="text-muted">Toplam kayıtlı</small>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
        <div class="card premium-stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="premium-icon-wrapper bg-gradient-info">
                            <i data-feather="dollar-sign" class="premium-icon"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-4">
                        <h4 class="premium-stat-number mb-1">₺45,678</h4>
                        <p class="premium-stat-label mb-0">Günlük Satış</p>
                        <div class="premium-stat-trend">
                            <i data-feather="trending-up" class="trend-icon text-success"></i>
                            <span class="trend-text">+18.9%</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer premium-card-footer">
                <small class="text-muted">Bugün</small>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Charts and Recent Activity -->
<div class="row">
    <!-- Sales Chart -->
