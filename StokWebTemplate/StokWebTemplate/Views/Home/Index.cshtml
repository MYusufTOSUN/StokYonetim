                                    class="avatar-xs rounded-circle bg-success d-flex align-items-center justify-content-center">
                                    <i data-feather="check" class="text-white" style="width: 12px; height: 12px;"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
