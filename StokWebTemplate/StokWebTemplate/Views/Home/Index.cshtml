@{
    ViewData["Title"] = "Dashboard - Ana Sayfa";
}

<!-- ✅ Dashboard Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="page-header">
            <h1 class="page-title">Dashboard</h1>
            <p class="page-subtitle text-muted">StokWeb Yönetim Paneli</p>
        </div>
    </div>
</div>

<!-- ✅ Mobile-Optimized Statistics Cards -->
