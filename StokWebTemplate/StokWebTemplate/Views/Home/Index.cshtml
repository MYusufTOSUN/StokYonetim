                        <p class="premium-stat-label mb-0">Toplam Ürün</p>
                        <div class="premium-stat-trend">
                            <i data-feather="trending-up" class="trend-icon text-success"></i>
                            <span class="trend-text">+12.5%</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer premium-card-footer">
                <small class="text-muted">Son 30 günde</small>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
        <div class="card premium-stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="premium-icon-wrapper bg-gradient-success">
                            <i data-feather="shopping-cart" class="premium-icon"></i>
