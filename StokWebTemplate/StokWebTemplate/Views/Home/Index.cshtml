                                <p class="text-muted mb-0 small">Ahmet Yılmaz - ₺1,250</p>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item px-0">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div
                                    class="avatar-xs rounded-circle bg-warning d-flex align-items-center justify-content-center">
                                    <i data-feather="clock" class="text-white" style="width: 12px; height: 12px;"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-1">SP-2024-002</h6>
                                <p class="text-muted mb-0 small">Fatma Kaya - ₺850</p>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item px-0">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div
                                    class="avatar-xs rounded-circle bg-info d-flex align-items-center justify-content-center">
                                    <i data-feather="truck" class="text-white" style="width: 12px; height: 12px;"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-1">SP-2024-003</h6>
                                <p class="text-muted mb-0 small">Mehmet Demir - ₺2,100</p>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item px-0">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div
                                    class="avatar-xs rounded-circle bg-primary d-flex align-items-center justify-content-center">
                                    <i data-feather="shopping-bag" class="text-white"
