@using System.Data
@using System.Linq
@model DataTable
@{
    Layout = "~/Views/Shared/_PersonelLayout.cshtml";
    ViewBag.Title = "Cari Görüntüleme";
    var sayfa = ViewBag.SayfaNo ?? 1;
    var toplamSayfa = ViewBag.ToplamSayfa ?? 1;
}

<!-- 🎨 PREMIUM CARI STYLES -->
<style>
    /* 🎯 ANIMATIONS */
    .fade-in {
        animation: fadeIn 0.8s ease-out;
    }

    .fade-in-up {
        animation: fadeInUp 0.8s ease-out;
    }

    .slide-in {
        animation: slideIn 0.6s ease-out;
    }

    .zoom-in {
        animation: zoomIn 0.7s ease-out;
    }

    @@keyframes fadeIn
    {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes fadeInUp
        {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes slideIn { 
                    from {
                        opacity: 0;
                        transform: translateX(-30px);
                    }

                    to {
                        opacity: 1;
                        transform: translateX(0);
                    }
                }

                @@keyframes zoomIn { 
                        0% {
                            opacity: 0;
                            transform: scale(0.8);
                        }

                        100% {
                            opacity: 1;
                            transform: scale(1);
                        }
                    }

                    /* 🏢 CARI HEADER */
                    .cari-header {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        border-radius: 25px;
                        padding: 3rem 2rem;
                        color: white;
                        margin-bottom: 2rem;
                        box-shadow: 0 20px 40px rgba(102, 126, 234, 0.3);
                        position: relative;
                        overflow: hidden;
                    }

                    .cari-header::before {
                        content: '🏢';
                        position: absolute;
                        top: 20px;
                        right: 20px;
                        font-size: 4rem;
                        opacity: 0.2;
                        animation: float 3s ease-in-out infinite;
                    }

                    @@keyframes float {

                            0%,
                            100% {
                                transform: translateY(0px) rotate(0deg);
                            }

                            50% {
                                transform: translateY(-10px) rotate(3deg);
                            }
                        }

                        /* 🏢 CARI TABLE */
                        .cari-table {
                            border-radius: 20px;
                            overflow: hidden;
                            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                            background: #fff;
                        }

                        .cari-table thead th {
                            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
                            color: white;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 1px;
                            padding: 20px 15px;
                            border: none;
                            position: relative;
                        }

                        .cari-table thead th::after {
                            content: '';
                            position: absolute;
                            bottom: 0;
                            left: 0;
                            width: 100%;
                            height: 3px;
                            background: linear-gradient(90deg, #667eea, #764ba2);
                        }

                        .cari-table tbody tr {
                            transition: all 0.3s ease;
                            border: none;
                            cursor: pointer;
                        }

                        .cari-table tbody tr:hover {
                            background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
                            transform: translateX(8px);
                            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
                        }

                        .cari-table tbody td {
                            padding: 18px 15px;
                            vertical-align: middle;
                            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
                            font-weight: 500;
                        }

                        /* 🏢 COMPANY INFO */
                        .company-card {
                            background: rgba(255, 255, 255, 0.95);
                            border-radius: 15px;
                            padding: 15px;
                            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
                            backdrop-filter: blur(10px);
                            border: 1px solid rgba(255, 255, 255, 0.2);
                            margin: 5px 0;
                        }

                        .company-avatar {
                            width: 50px;
                            height: 50px;
                            border-radius: 50%;
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            color: white;
                            font-weight: bold;
                            font-size: 1.3rem;
                            margin-right: 15px;
                            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
                            animation: pulse 2s infinite;
                        }

                        @@keyframes pulse {

                                0%,
                                100% {
                                    transform: scale(1);
                                }

                                50% {
                                    transform: scale(1.05);
                                }
                            }

                            /* 🏷️ TYPE BADGES */
                            .type-badge {
                                padding: 8px 16px;
                                border-radius: 25px;
                                font-size: 0.9em;
                                font-weight: 700;
                                text-align: center;
                                min-width: 80px;
                                display: inline-block;
                                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                            }

                            .type-alim {
                                background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
                                color: white;
                                animation: shimmer 3s infinite;
                            }

                            .type-satim {
                                background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
                                color: white;
                                animation: shimmer 3s infinite;
                            }

                            @@keyframes shimmer {

                                    0%,
                                    100% {
                                        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                                    }

                                    50% {
                                        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
                                    }
                                }

                                .code-display {
                                    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
                                    padding: 8px 12px;
                                    border-radius: 12px;
                                    border-left: 4px solid #667eea;
                                    font-family: 'Courier New', monospace;
                                    font-weight: 600;
                                    color: #374151;
                                    letter-spacing: 1px;
                                }

                                /* 📊 SUMMARY CARDS */
                                .summary-section {
                                    background: rgba(255, 255, 255, 0.95);
                                    border-radius: 20px;
                                    padding: 2rem;
                                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                                    backdrop-filter: blur(10px);
                                    border: 1px solid rgba(255, 255, 255, 0.2);
                                    margin-bottom: 2rem;
                                }

                                /* 🎪 STAGGER DELAYS */
                                .stagger-1 {
                                    animation-delay: 0.1s;
                                }

                                .stagger-2 {
                                    animation-delay: 0.2s;
                                }

                                .stagger-3 {
                                    animation-delay: 0.3s;
                                }

                                .stagger-4 {
                                    animation-delay: 0.4s;
                                }

                                /* 📱 RESPONSIVE */
                                @@media(max - width: 768px) {
                                        .cari-header {
                                            padding: 2rem 1.5rem;
                                        }

                                        .cari-table {
                                            font-size: 0.9em;
                                        }

                                        .cari-table thead th,
                                        .cari-table tbody td {
                                            padding: 12px 8px;
                                        }

                                        .company-avatar {
                                            width: 40px;
                                            height: 40px;
                                            font-size: 1.1rem;
                                        }

                                        .summary-section {
                                            padding: 1.5rem;
                                        }
                                    }
                                </style>

                                <div class="container-fluid">
                                    <div id="messageArea"></div>
                                    
                                    <!-- 🏢 CARI HEADER -->
                                    <div class="cari-header fade-in">
                                        <div class="row align-items-center">
                                            <div class="col-md-8">
                                                <h1 class="display-5 fw-bold mb-2">🏢 Cari Hesap Merkezi</h1>
                                                <p class="lead mb-0 opacity-90">Müşteri ve tedarikçi bilgilerini görüntüleyin</p>
                                            </div>
                                        </div>
                                    </div>

                                     

                                    <!-- 🎛️ FILTER SECTION -->
                                    <div class="card border-0 shadow-lg mb-4 fade-in-up stagger-2" style="border-radius: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        <div class="card-body p-4">
                                            <div class="row align-items-center">
                                                <div class="col-md-6">
                                                    <form asp-action="Index" method="get" class="d-flex align-items-center gap-3" onchange="this.submit()">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <i class="fas fa-filter text-white fa-lg"></i>
                                                            <label class="fw-bold mb-0 text-white">Cari Filtrele:</label>
                                                            <select name="tip" class="form-select" style="border-radius: 12px; border: 2px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.9);">
                                                                @Html.Raw($"<option value='T' {(ViewBag.Tip == "T" || ViewBag.Tip == null ? "selected" : "")}>🔄 Tümü</option>")
                                                                @Html.Raw($"<option value='A' {(ViewBag.Tip == "A" ? "selected" : "")}>📥 Tedarikçiler</option>")
                                                                @Html.Raw($"<option value='V' {(ViewBag.Tip == "V" ? "selected" : "")}>📤 Müşteriler</option>")
                                                            </select>
                                                        </div>
                                                    </form>
                                                </div>
                                                <div class="col-md-6 text-end">
                                                    <div class="d-flex gap-2 justify-content-end">
                                                        <button onclick="exportCariCsv('@ViewBag.Tip')" class="btn btn-light action-btn">
                                                            <i class="fas fa-file-csv me-2"></i>CSV İndir
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 🏢 CARI TABLE -->
                                    <div class="cari-table fade-in-up stagger-2">
                                        <table class="table table-hover mb-0">
                                            <thead>
                                                <tr>
                                                    <th><i class="fas fa-hashtag me-2"></i>ID</th>
                                                    <th><i class="fas fa-building me-2"></i>Şirket Bilgileri</th>
                                                    <th><i class="fas fa-tag me-2"></i>İşlem Türü</th>
                                                    <th><i class="fas fa-code me-2"></i>Özel Kod</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Rows.Count > 0)
                                                {
                                                    foreach (System.Data.DataRow row in Model.Rows)
                                                    {
                                                        var company = row["CARI_SIRKET"].ToString();
                                                        var companyInitial = !string.IsNullOrEmpty(company) ? company.Substring(0, 1).ToUpper() : "?";
                                                        var isAlim = row["CARI_TIP"].ToString() == "A";

                                                        <tr class="slide-in">
                                                            <td>
                                                                <span class="badge bg-primary fs-6">@row["CARI_ID"]</span>
                                                            </td>
                                                            <td>
                                                                <div class="d-flex align-items-center">
                                                                    <div class="company-avatar zoom-in">
                                                                        @companyInitial
                                                                    </div>
                                                                    <div>
                                                                        <strong class="text-primary">@company</strong>
                                                                        <br><small class="text-muted">@(isAlim ? "Tedarikçi Firma" : "Müşteri Firma")</small>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <span class="type-badge @(isAlim ? "type-alim" : "type-satim")">
                                                                    @(isAlim ? "📥 Tedarikçi" : "📤 Müşteri")
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <div class="code-display">
                                                                    @row["OZEL_KOD"]
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="4" class="text-center py-5">
                                                            <div class="text-muted">
                                                                <i class="fas fa-building fa-4x mb-4 opacity-50"></i>
                                                                <h4>🏢 Cari Bulunamadı</h4>
                                                                <p class="mb-0">Henüz kayıtlı cari hesap bulunmuyor.</p>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- 📄 MODERN PAGINATION -->
                                    @if (toplamSayfa > 1)
                                    {
                                        <div class="pagination-container" data-total-pages="@toplamSayfa">
                                            <nav>
                                                <ul class="pagination">
                                                    @if (sayfa > 1)
                                                    {
                                                        <li class="page-item">
                                                            <a class="page-link" asp-action="Index" asp-route-tip="@ViewBag.Tip" asp-route-sayfa="@(sayfa - 1)" aria-label="Önceki">
                                                                <i class="fas fa-chevron-left"></i>
                                                            </a>
                                                        </li>
                                                    }
                                                    
                                                    @{
                                                        int startPage = Math.Max(1, sayfa - 2);
                                                        int endPage = Math.Min(toplamSayfa, sayfa + 2);
                                                        
                                                        if (startPage > 1)
                                                        {
                                                            <li class="page-item">
                                                                <a class="page-link" asp-action="Index" asp-route-tip="@ViewBag.Tip" asp-route-sayfa="1">1</a>
                                                            </li>
                                                            if (startPage > 2)
                                                            {
                                                                <li class="page-item disabled">
                                                                    <span class="pagination-ellipsis">...</span>
                                                                </li>
                                                            }
                                                        }
                                                        
                                                        for (int i = startPage; i <= endPage; i++)
                                                        {
                                                            <li class="page-item @(i == sayfa ? "active" : "")">
                                                                <a class="page-link" asp-action="Index" asp-route-tip="@ViewBag.Tip" asp-route-sayfa="@i">@i</a>
                                                            </li>
                                                        }
                                                        
                                                        if (endPage < toplamSayfa)
                                                        {
                                                            if (endPage < toplamSayfa - 1)
                                                            {
                                                                <li class="page-item disabled">
                                                                    <span class="pagination-ellipsis">...</span>
                                                                </li>
                                                            }
                                                            <li class="page-item">
                                                                <a class="page-link" asp-action="Index" asp-route-tip="@ViewBag.Tip" asp-route-sayfa="@toplamSayfa">@toplamSayfa</a>
                                                            </li>
                                                        }
                                                    }
                                                    
                                                    @if (sayfa < toplamSayfa)
                                                    {
                                                        <li class="page-item">
                                                            <a class="page-link" asp-action="Index" asp-route-tip="@ViewBag.Tip" asp-route-sayfa="@(sayfa + 1)" aria-label="Sonraki">
                                                                <i class="fas fa-chevron-right"></i>
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </nav>
                                            <div class="pagination-info">
                                                <small class="text-muted">📄 Sayfa @sayfa / @toplamSayfa</small>
                                            </div>
                                        </div>
                                    }

                                    <!-- 📊 STATISTICS CARDS -->
                                    <div class="row mt-5">
                                        <div class="col-md-6">
                                            <div class="card border-0 shadow-lg fade-in-up stagger-4"
                                                style="background: linear-gradient(135deg, #10b981 0%, #34d399 100%);">
                                                <div class="card-body text-center text-white p-4">
                                                    <i class="fas fa-truck fa-3x mb-3"></i>
                                                    <h5>Tedarikçi Firmaları</h5>
                                                    <h3>@(Model?.AsEnumerable().Count(r => r["CARI_TIP"].ToString() == "A") ?? 0)</h3>
                                                    <small class="opacity-75">Mal ve hizmet alınan</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card border-0 shadow-lg fade-in-up stagger-4"
                                                style="background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);">
                                                <div class="card-body text-center text-white p-4">
                                                    <i class="fas fa-handshake fa-3x mb-3"></i>
                                                    <h5>Müşteri Firmaları</h5>
                                                    <h3>@(Model?.AsEnumerable().Count(r => r["CARI_TIP"].ToString() == "V") ?? 0)</h3>
                                                    <small class="opacity-75">Mal ve hizmet satılan</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 🎪 ANIMATION SCRIPT -->
                                <script>
                                    document.addEventListener('DOMContentLoaded', function () {
                                        // Animation Observer
                                        const observer = new IntersectionObserver((entries) => {
                                            entries.forEach(entry => {
                                                if (entry.isIntersecting) {
                                                    entry.target.style.animationPlayState = 'running';
                                                }
                                            });
                                        }, { threshold: 0.1 });

                                        // Observe all animated elements
                                        document.querySelectorAll('.fade-in, .fade-in-up, .slide-in, .zoom-in').forEach(el => {
                                            el.style.animationPlayState = 'paused';
                                            observer.observe(el);
                                        });

                                        // Add hover effects to table rows
                                        document.querySelectorAll('.cari-table tbody tr').forEach(row => {
                                            row.addEventListener('mouseenter', function () {
                                                this.style.transform = 'translateX(8px)';
                                            });

                                            row.addEventListener('mouseleave', function () {
                                                this.style.transform = 'translateX(0)';
                                            });
                                        });
                                    });

                                    // CSV Export Function
                                    function exportCariCsv(tip) {
                                        const btn = event.target;
                                        const originalText = btn.innerHTML;
                                        
                                        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>İndiriliyor...';
                                        btn.disabled = true;
                                        
                                        fetch(`/PersonelCari/ExportCariCsv?tip=${encodeURIComponent(tip)}`)
                                            .then(response => {
                                                if (response.ok) {
                                                    return response.blob();
                                                }
                                                throw new Error('Export failed');
                                            })
                                            .then(blob => {
                                                const url = window.URL.createObjectURL(blob);
                                                const a = document.createElement('a');
                                                a.href = url;
                                                a.download = `cariler_${tip}.csv`;
                                                document.body.appendChild(a);
                                                a.click();
                                                document.body.removeChild(a);
                                                window.URL.revokeObjectURL(url);
                                                
                                                showNotification('✅ Cari listesi başarıyla indirildi!', 'success');
                                            })
                                            .catch(error => {
                                                console.error('Export error:', error);
                                                showNotification('❌ CSV indirme hatası!', 'error');
                                            })
                                            .finally(() => {
                                                btn.innerHTML = originalText;
                                                btn.disabled = false;
                                            });
                                    }
                                </script>
