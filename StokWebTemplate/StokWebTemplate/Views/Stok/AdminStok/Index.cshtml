@using System.Data
@model DataTable

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Stok Yönetimi";
    int sayfaNo = ViewBag.SayfaNo ?? 1;
    int toplamSayfa = ViewBag.ToplamSayfa ?? 1;
    string seciliAd = ViewBag.StokAd ?? "T";
    var stokAdlari = ViewBag.StokAdlari as List<string>;
}

<!-- 🎨 PREMIUM STOK PAGE STYLES -->
<style>
    /* 🎯 ANIMATIONS */
    .fade-in { animation: fadeIn 0.8s ease-out; }
    .fade-in-up { animation: fadeInUp 0.8s ease-out; }
    .slide-in { animation: slideIn 0.6s ease-out; }
    
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes slideIn { from { opacity: 0; transform: translateX(-30px); } to { opacity: 1; transform: translateX(0); } }
    
    /* 📦 INVENTORY HEADER */
    .inventory-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 2rem;
        color: white;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        position: relative;
        overflow: hidden;
    }
    
    .inventory-header::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%);
        transform: rotate(45deg);
        animation: shine 4s infinite;
    }
    
    @@keyframes shine {
        0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
        100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
    }
    
    /* 📊 STOCK TABLE */
    .stock-table {
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        background: #fff;
    }
    
    .stock-table thead th {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 20px 15px;
        border: none;
        position: relative;
    }
    
    .stock-table thead th::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, #667eea, #764ba2);
    }
    
    .stock-table tbody tr {
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }
    
    .stock-table tbody tr:hover {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        transform: translateX(8px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }
    
    .stock-table tbody td {
        padding: 18px 15px;
        vertical-align: middle;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        font-weight: 500;
    }
    
    /* 📈 STOCK INDICATORS */
    .stock-indicator {
        padding: 8px 15px;
        border-radius: 25px;
        font-size: 0.9em;
        font-weight: 700;
        text-align: center;
        min-width: 80px;
        display: inline-block;
    }
    
    .stock-positive {
        background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        color: white;
    }
    
    .stock-negative {
        background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
        color: white;
    }
    
    .stock-zero {
        background: linear-gradient(135deg, #64748b 0%, #94a3b8 100%);
        color: white;
    }
    
    /* 🎪 ACTION BUTTONS */
    .action-btn {
        border-radius: 12px;
        padding: 10px 15px;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        margin: 0 2px;
    }
    
    .action-btn:hover {
        transform: translateY(-3px) scale(1.1);
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
    
    .action-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.5s;
    }
    
    .action-btn:hover::before { left: 100%; }
    
    /* 🎯 STAGGER DELAYS */
    .stagger-1 { animation-delay: 0.1s; }
    .stagger-2 { animation-delay: 0.2s; }
    .stagger-3 { animation-delay: 0.3s; }
    
    /* 📱 RESPONSIVE */
    @@media (max-width: 768px) {
        .stock-table { font-size: 0.9em; }
        .stock-table thead th, .stock-table tbody td { padding: 12px 8px; }
        .inventory-header { padding: 1.5rem; }
    }
</style>

<div class="container-fluid">
    <div id="messageArea"></div>
    
    <!-- 📦 INVENTORY HEADER -->
    <div class="inventory-header fade-in">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-2">📦 Stok Yönetimi</h1>
                <p class="lead mb-0 opacity-90">Envanter durumunu takip edin ve yönetin</p>
            </div>
            <div class="col-md-4 text-end">
                <div class="d-flex align-items-center justify-content-end gap-3">
                    <i class="fas fa-cubes fa-3x opacity-75"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 🎛️ FILTER & ACTIONS -->
    <div class="card border-0 shadow-lg mb-4 fade-in-up stagger-1" style="border-radius: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <form asp-action="Index" method="get" class="d-flex align-items-center gap-3" onchange="this.submit()">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-filter text-white fa-lg"></i>
                            <label class="fw-bold mb-0 text-white">Stok Filtrele:</label>
                            <select name="stokad" class="form-select" style="border-radius: 12px; border: 2px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.9);">
                                @Html.Raw($"<option value='T' {(seciliAd == "T" ? "selected" : "")}>📦 Tüm Stoklar</option>")
                                @if (stokAdlari != null)
                                {
                                    foreach (string ad in stokAdlari)
                                    {
                                        @Html.Raw($"<option value='{ad}' {(seciliAd == ad ? "selected" : "")}>🏷️ {ad}</option>")
                                    }
                                }
                            </select>
                        </div>
                    </form>
                </div>
                <div class="col-md-6 text-end">
                    <div class="d-flex gap-2 justify-content-end">
                        <button onclick="exportStokCsv('@seciliAd')" class="btn btn-light action-btn">
                            <i class="fas fa-file-csv me-2"></i>CSV İndir
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 📊 STOCK TABLE -->
    <div class="stock-table fade-in-up stagger-2">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><i class="fas fa-hashtag me-2"></i>ID</th>
                    <th><i class="fas fa-cube me-2"></i>Stok Adı</th>
                    <th><i class="fas fa-balance-scale me-2"></i>Birim</th>
                    <th><i class="fas fa-code me-2"></i>Özel Kod</th>
                    <th><i class="fas fa-arrow-down text-success me-2"></i>Alınan</th>
                    <th><i class="fas fa-arrow-up text-danger me-2"></i>Verilen</th>
                    <th><i class="fas fa-chart-bar me-2"></i>Durum</th>
                    <th><i class="fas fa-cogs me-2"></i>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Rows.Count > 0)
                {
                    foreach (DataRow row in Model.Rows)
                    {
                        var alinan = Convert.ToDouble(row["ALINAN_SIPARIS_MIKTARI"] ?? 0);
                        var verilen = Convert.ToDouble(row["VERILEN_SIPARIS_MIKTARI"] ?? 0);
                        var fark = alinan - verilen;
                        
                        <tr class="slide-in">
                            <td>
                                <span class="badge bg-primary fs-6">@row["STOK_ID"]</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" 
                                         style="width: 40px; height: 40px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        <i class="fas fa-cube text-white"></i>
                                    </div>
                                    <div>
                                        <strong class="text-primary">@row["STOK_AD"]</strong>
                                        <br><small class="text-muted">Stok Ürünü</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@row["BIRIM"]</span>
                            </td>
                            <td>
                                <code class="bg-light text-dark p-2 rounded">@row["OZEL_KOD"]</code>
                            </td>
                            <td>
                                <span class="badge bg-success fs-6">📈 @alinan.ToString("N0")</span>
                            </td>
                            <td>
                                <span class="badge bg-info fs-6">📉 @verilen.ToString("N0")</span>
                            </td>
                            <td>
                                @if (fark > 0)
                                {
                                    <span class="stock-indicator stock-positive">
                                        ✅ +@fark.ToString("N0")
                                    </span>
                                }
                                else if (fark < 0)
                                {
                                    <span class="stock-indicator stock-negative">
                                        ⚠️ @fark.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    <span class="stock-indicator stock-zero">
                                        ⚪ 0
                                    </span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-outline-primary action-btn btn-sm" asp-action="Log" asp-route-id="@row["STOK_ID"]" title="Stok Hareketleri">
                                    <i class="fas fa-eye me-1"></i>Detay
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <div class="text-muted">
                                <i class="fas fa-cube fa-4x mb-4 opacity-50"></i>
                                <h4>📦 Stok Bulunamadı</h4>
                                <p class="mb-0">Seçili kriterlere uygun stok bulunmuyor.</p>
                                <a asp-action="Yeni" class="btn btn-primary mt-3">
                                    <i class="fas fa-plus me-2"></i>İlk Stoğu Ekle
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 📄 MODERN PAGINATION -->
    @if (toplamSayfa > 1)
    {
        <div class="pagination-container" data-total-pages="@toplamSayfa">
            <nav>
                <ul class="pagination">
                    @if (sayfaNo > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?stokad=@seciliAd&sayfa=@(sayfaNo - 1)" aria-label="Önceki">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    }
                    
                    @{
                        int startPage = Math.Max(1, sayfaNo - 2);
                        int endPage = Math.Min(toplamSayfa, sayfaNo + 2);
                        
                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?stokad=@seciliAd&sayfa=1">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="pagination-ellipsis">...</span>
                                </li>
                            }
                        }
                        
                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == sayfaNo ? "active" : "")">
                                <a class="page-link" href="?stokad=@seciliAd&sayfa=@i">@i</a>
                            </li>
                        }
                        
                        if (endPage < toplamSayfa)
                        {
                            if (endPage < toplamSayfa - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="pagination-ellipsis">...</span>
                                </li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="?stokad=@seciliAd&sayfa=@toplamSayfa">@toplamSayfa</a>
                            </li>
                        }
                    }
                    
                    @if (sayfaNo < toplamSayfa)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?stokad=@seciliAd&sayfa=@(sayfaNo + 1)" aria-label="Sonraki">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
            <div class="pagination-info">
                <small class="text-muted">📄 Sayfa @sayfaNo / @toplamSayfa</small>
            </div>
        </div>
    }

    <!-- 📊 STOCK SUMMARY -->
    <div class="row mt-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-lg fade-in-up stagger-3" style="background: linear-gradient(135deg, #10b981 0%, #34d399 100%);">
                <div class="card-body text-center text-white p-4">
                    <i class="fas fa-plus-circle fa-2x mb-3"></i>
                    <h5>Pozitif Stok</h5>
                    <h3>@(Model?.AsEnumerable().Count(r => (Convert.ToDouble(r["ALINAN_SIPARIS_MIKTARI"]) - Convert.ToDouble(r["VERILEN_SIPARIS_MIKTARI"])) > 0) ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-lg fade-in-up stagger-3" style="background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);">
                <div class="card-body text-center text-white p-4">
                    <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                    <h5>Negatif Stok</h5>
                    <h3>@(Model?.AsEnumerable().Count(r => (Convert.ToDouble(r["ALINAN_SIPARIS_MIKTARI"]) - Convert.ToDouble(r["VERILEN_SIPARIS_MIKTARI"])) < 0) ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-lg fade-in-up stagger-3" style="background: linear-gradient(135deg, #64748b 0%, #94a3b8 100%);">
                <div class="card-body text-center text-white p-4">
                    <i class="fas fa-equals fa-2x mb-3"></i>
                    <h5>Sıfır Stok</h5>
                    <h3>@(Model?.AsEnumerable().Count(r => (Convert.ToDouble(r["ALINAN_SIPARIS_MIKTARI"]) - Convert.ToDouble(r["VERILEN_SIPARIS_MIKTARI"])) == 0) ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-lg fade-in-up stagger-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body text-center text-white p-4">
                    <i class="fas fa-cubes fa-2x mb-3"></i>
                    <h5>Toplam Stok</h5>
                    <h3>@(Model?.Rows.Count ?? 0)</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🚀 JAVASCRIPT FUNCTIONS -->
<script>
    // CSV Export Function
    function exportStokCsv(stokAd) {
        const btn = event.target;
        const originalText = btn.innerHTML;
        
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>İndiriliyor...';
        btn.disabled = true;
        
        fetch(`/AdminStok/ExportStokCsv?stokad=${stokAd}`)
            .then(response => {
                if (response.ok) {
                    return response.blob();
                }
                throw new Error('Export failed');
            })
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `stoklar_${stokAd}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
                
                showNotification('✅ Stok listesi başarıyla indirildi!', 'success');
            })
            .catch(error => {
                console.error('Export error:', error);
                showNotification('❌ CSV indirme hatası!', 'error');
            })
            .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
    }
</script>