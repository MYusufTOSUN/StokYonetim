@using System.Data
@using System.Linq
@using System.Linq
@model System.Data.DataTable
@{
    Layout = "~/Views/Shared/_PersonelLayout.cshtml";
    ViewBag.Title = "Stok Görüntüleme";
    var sayfa = ViewBag.SayfaNo ?? 1;
    var toplamSayfa = ViewBag.ToplamSayfa ?? 1;
}

<!-- 🎨 PREMIUM PERSONEL STOK STYLES -->
<style>
    /* 🎯 ANIMATIONS */
    .fade-in {
        animation: fadeIn 0.8s ease-out;
    }

    .fade-in-up {
        animation: fadeInUp 0.8s ease-out;
    }

    .slide-in {
        animation: slideIn 0.6s ease-out;
    }

    .rotate-in {
        animation: rotateIn 0.8s ease-out;
    }

    @@keyframes fadeIn
    {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes fadeInUp
        {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes slideIn {
                    from {
                        opacity: 0;
                        transform: translateX(-30px);
                    }

                    to {
                        opacity: 1;
                        transform: translateX(0);
                    }
                }

                @@keyframes rotateIn {
                        0% {
                            opacity: 0;
                            transform: rotate(-200deg) scale(0);
                        }

                        100% {
                            opacity: 1;
                            transform: rotate(0deg) scale(1);
                        }
                    }

                    /* 📦 STOK HEADER */
                    .stok-header {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        border-radius: 25px;
                        padding: 3rem 2rem;
                        color: white;
                        margin-bottom: 2rem;
                        box-shadow: 0 20px 40px rgba(102, 126, 234, 0.3);
                        position: relative;
                        overflow: hidden;
                    }

                    .stok-header::before {
                        content: '📦';
                        position: absolute;
                        top: 20px;
                        right: 20px;
                        font-size: 4rem;
                        opacity: 0.2;
                        animation: spin 6s linear infinite;
                    }

                    @@keyframes spin {
                            0% {
                                transform: rotate(0deg);
                            }

                            100% {
                                transform: rotate(360deg);
                            }
                        }

                        /* 📊 STOK SUMMARY */
                        .stok-summary {
                            background: rgba(255, 255, 255, 0.95);
                            border-radius: 20px;
                            padding: 2rem;
                            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                            backdrop-filter: blur(10px);
                            border: 1px solid rgba(255, 255, 255, 0.2);
                            margin-bottom: 2rem;
                        }

                        /* 📦 STOK TABLE */
                        .stok-table {
                            border-radius: 20px;
                            overflow: hidden;
                            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                            background: #fff;
                        }

                        .stok-table thead th {
                            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
                            color: white;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 1px;
                            padding: 20px 15px;
                            border: none;
                            position: relative;
                        }

                        .stok-table thead th::after {
                            content: '';
                            position: absolute;
                            bottom: 0;
                            left: 0;
                            width: 100%;
                            height: 3px;
                            background: linear-gradient(90deg, #667eea, #764ba2);
                        }

                        .stok-table tbody tr {
                            transition: all 0.3s ease;
                            border: none;
                            cursor: pointer;
                        }

                        .stok-table tbody tr:hover {
                            background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
                            transform: translateX(8px);
                            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
                        }

                        .stok-table tbody td {
                            padding: 18px 15px;
                            vertical-align: middle;
                            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
                            font-weight: 500;
                        }

                        /* 📦 PRODUCT INFO */
                        .product-avatar {
                            width: 50px;
                            height: 50px;
                            border-radius: 50%;
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            color: white;
                            font-weight: bold;
                            font-size: 1.3rem;
                            margin-right: 15px;
                            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
                            animation: float 3s ease-in-out infinite;
                        }

                        @@keyframes float {

                                0%,
                                100% {
                                    transform: translateY(0px);
                                }

                                50% {
                                    transform: translateY(-5px);
                                }
                            }

                            .unit-badge {
                                background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%);
                                color: white;
                                padding: 6px 12px;
                                border-radius: 20px;
                                font-size: 0.8em;
                                font-weight: 600;
                                box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
                            }

                            .code-display {
                                background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
                                padding: 8px 12px;
                                border-radius: 12px;
                                border-left: 4px solid #667eea;
                                font-family: 'Courier New', monospace;
                                font-weight: 600;
                                color: #374151;
                                letter-spacing: 1px;
                            }

                            /* 📊 QUANTITY DISPLAYS */
                            .quantity-card {
                                background: rgba(255, 255, 255, 0.9);
                                border-radius: 15px;
                                padding: 12px;
                                text-align: center;
                                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
                                margin: 2px 0;
                            }

                            .quantity-received {
                                border-left: 4px solid #10b981;
                                background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(52, 211, 153, 0.1) 100%);
                            }

                            .quantity-delivered {
                                border-left: 4px solid #f59e0b;
                                background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(251, 191, 36, 0.1) 100%);
                            }

                            .quantity-balance {
                                padding: 10px 15px;
                                border-radius: 20px;
                                font-weight: bold;
                                text-align: center;
                                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                            }

                            .balance-positive {
                                background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
                                color: white;
                            }

                            .balance-negative {
                                background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
                                color: white;
                            }

                            .balance-zero {
                                background: linear-gradient(135deg, #64748b 0%, #94a3b8 100%);
                                color: white;
                            }

                            /* 🎪 STAGGER DELAYS */
                            .stagger-1 {
                                animation-delay: 0.1s;
                            }

                            .stagger-2 {
                                animation-delay: 0.2s;
                            }

                            .stagger-3 {
                                animation-delay: 0.3s;
                            }

                            .stagger-4 {
                                animation-delay: 0.4s;
                            }

                            /* 📱 RESPONSIVE */
                            @@media (max-width: 768px) {
                                    .stok-header {
                                        padding: 2rem 1.5rem;
                                    }

                                    .stok-table {
                                        font-size: 0.9em;
                                    }

                                    .stok-table thead th,
                                    .stok-table tbody td {
                                        padding: 12px 8px;
                                    }

                                    .product-avatar {
                                        width: 40px;
                                        height: 40px;
                                        font-size: 1.1rem;
                                    }

                                    .stok-summary {
                                        padding: 1.5rem;
                                    }
                                }
                            </style>

                            <div class="container-fluid">
                                <div id="messageArea"></div>
                                
                                <!-- 📦 STOK HEADER -->
                                <div class="stok-header fade-in">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <h1 class="display-5 fw-bold mb-2">📦 Stok Görüntüleme</h1>
                                            <p class="lead mb-0 opacity-90">Mevcut stok durumunu görüntüleyin ve takip edin</p>
                                        </div>
                                    </div>
                                </div>

                                

    @if (TempData["Message"] != null)
                                    {
                                        <div class="alert alert-info alert-dismissible fade show fade-in-up stagger-2" role="alert">
                                            <i class="fas fa-info-circle me-2"></i>@TempData["Message"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                        </div>
                                    }

                                    <!-- 🎛️ FILTER SECTION -->
                                    <div class="card border-0 shadow-lg mb-4 fade-in-up stagger-2" style="border-radius: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        <div class="card-body p-4">
                                            <div class="row align-items-center">
                                                <div class="col-md-6">
                                                    <form asp-action="Index" method="get" class="d-flex align-items-center gap-3" onchange="this.submit()">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <i class="fas fa-filter text-white fa-lg"></i>
                                                            <label class="fw-bold mb-0 text-white">Stok Filtrele:</label>
                                                            <select name="stokad" class="form-select" style="border-radius: 12px; border: 2px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.9);">
                                                                @Html.Raw($"<option value='T' {(ViewBag.StokAd == "T" || ViewBag.StokAd == null ? "selected" : "")}>📦 Tüm Stoklar</option>")
                                                                @if (ViewBag.StokAdlari != null)
                                                                {
                                                                    foreach (string ad in ViewBag.StokAdlari)
                                                                    {
                                                                        @Html.Raw($"<option value='{ad}' {(ViewBag.StokAd == ad ? "selected" : "")}>🏷️ {ad}</option>")
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </form>
                                                </div>
                                                <div class="col-md-6 text-end">
                                                    <div class="d-flex gap-2 justify-content-end">
                                                        <button onclick="exportStokCsv('@ViewBag.StokAd')" class="btn btn-light action-btn">
                                                            <i class="fas fa-file-csv me-2"></i>CSV İndir
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 📦 STOK TABLE -->
                                    <div class="stok-table fade-in-up stagger-3">
                                        <table class="table table-hover mb-0">
                                            <thead>
                                                <tr>
                                                    <th><i class="fas fa-hashtag me-2"></i>ID</th>
                                                    <th><i class="fas fa-cube me-2"></i>Stok Bilgileri</th>
                                                    <th><i class="fas fa-balance-scale me-2"></i>Birim</th>
                                                    <th><i class="fas fa-code me-2"></i>Özel Kod</th>
                                                    <th><i class="fas fa-arrow-down text-success me-2"></i>Alınan</th>
                                                    <th><i class="fas fa-arrow-up text-warning me-2"></i>Verilen</th>
                                                    <th><i class="fas fa-chart-bar me-2"></i>Durum</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Rows.Count > 0)
                                                {
                                                    foreach (System.Data.DataRow row in Model.Rows)
                                                    {
                                                        var stockName = row["STOK_AD"].ToString();
                                                        var stockInitial = !string.IsNullOrEmpty(stockName) ? stockName.Substring(0, 1).ToUpper() : "?";
                                                        var alinan = Convert.ToDouble(row["ALINAN_SIPARIS_MIKTARI"] ?? 0);
                                                        var verilen = Convert.ToDouble(row["VERILEN_SIPARIS_MIKTARI"] ?? 0);
                                                        var balance = alinan - verilen;

                                                        <tr class="slide-in">
                                                            <td>
                                                                <span class="badge bg-primary fs-6">@row["STOK_ID"]</span>
                                                            </td>
                                                            <td>
                                                                <div class="d-flex align-items-center">
                                                                    <div class="product-avatar rotate-in">
                                                                        @stockInitial
                                                                    </div>
                                                                    <div>
                                                                        <strong class="text-primary">@stockName</strong>
                                                                        <br><small class="text-muted">Stok Ürünü</small>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <span class="unit-badge">@row["BIRIM"]</span>
                                                            </td>
                                                            <td>
                                                                <div class="code-display">
                                                                    @row["OZEL_KOD"]
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="quantity-card quantity-received">
                                                                    <strong class="text-success">📈 @alinan.ToString("N0")</strong>
                                                                    <br><small class="text-muted">Gelen</small>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="quantity-card quantity-delivered">
                                                                    <strong class="text-warning">📉 @verilen.ToString("N0")</strong>
                                                                    <br><small class="text-muted">Çıkan</small>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                @if (balance > 0)
                                                                {
                                                                    <div class="quantity-balance balance-positive">
                                                                        ✅ +@balance.ToString("N0")
                                                                    </div>
                                                                }
                                                                else if (balance < 0)
                                                                {
                                                                    <div class="quantity-balance balance-negative">
                                                                        ⚠️ @balance.ToString("N0")
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="quantity-balance balance-zero">
                                                                        ⚪ 0
                                                                    </div>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="7" class="text-center py-5">
                                                            <div class="text-muted">
                                                                <i class="fas fa-cube fa-4x mb-4 opacity-50"></i>
                                                                <h4>📦 Stok Bulunamadı</h4>
                                                                <p class="mb-0">Henüz kayıtlı stok bulunmuyor.</p>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- 📄 MODERN PAGINATION -->
                                    @if (toplamSayfa > 1)
                                    {
                                        <div class="pagination-container" data-total-pages="@toplamSayfa">
                                            <nav>
                                                <ul class="pagination">
                                                    @if (sayfa > 1)
                                                    {
                                                        <li class="page-item">
                                                            <a class="page-link" asp-action="Index" asp-route-stokad="@ViewBag.StokAd" asp-route-sayfa="@(sayfa - 1)" aria-label="Önceki">
                                                                <i class="fas fa-chevron-left"></i>
                                                            </a>
                                                        </li>
                                                    }
                                                    
                                                    @{
                                                        int startPage = Math.Max(1, sayfa - 2);
                                                        int endPage = Math.Min(toplamSayfa, sayfa + 2);
                                                        
                                                        if (startPage > 1)
                                                        {
                                                            <li class="page-item">
                                                                <a class="page-link" asp-action="Index" asp-route-stokad="@ViewBag.StokAd" asp-route-sayfa="1">1</a>
                                                            </li>
                                                            if (startPage > 2)
                                                            {
                                                                <li class="page-item disabled">
                                                                    <span class="pagination-ellipsis">...</span>
                                                                </li>
                                                            }
                                                        }
                                                        
                                                        for (int i = startPage; i <= endPage; i++)
                                                        {
                                                            <li class="page-item @(i == sayfa ? "active" : "")">
                                                                <a class="page-link" asp-action="Index" asp-route-stokad="@ViewBag.StokAd" asp-route-sayfa="@i">@i</a>
                                                            </li>
                                                        }
                                                        
                                                        if (endPage < toplamSayfa)
                                                        {
                                                            if (endPage < toplamSayfa - 1)
                                                            {
                                                                <li class="page-item disabled">
                                                                    <span class="pagination-ellipsis">...</span>
                                                                </li>
                                                            }
                                                            <li class="page-item">
                                                                <a class="page-link" asp-action="Index" asp-route-stokad="@ViewBag.StokAd" asp-route-sayfa="@toplamSayfa">@toplamSayfa</a>
                                                            </li>
                                                        }
                                                    }
                                                    
                                                    @if (sayfa < toplamSayfa)
                                                    {
                                                        <li class="page-item">
                                                            <a class="page-link" asp-action="Index" asp-route-stokad="@ViewBag.StokAd" asp-route-sayfa="@(sayfa + 1)" aria-label="Sonraki">
                                                                <i class="fas fa-chevron-right"></i>
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </nav>
                                            <div class="pagination-info">
                                                <small class="text-muted">📄 Sayfa @sayfa / @toplamSayfa</small>
                                            </div>
                                        </div>
                                    }

                                    <!-- 📊 DETAILED STATISTICS -->
                                    <div class="row mt-5">
                                        <div class="col-md-3">
                                            <div class="card border-0 shadow-lg fade-in-up stagger-4"
                                                style="background: linear-gradient(135deg, #10b981 0%, #34d399 100%);">
                                                <div class="card-body text-center text-white p-4">
                                                    <i class="fas fa-plus-circle fa-3x mb-3"></i>
                                                    <h5>Pozitif Stok</h5>
                                                    <h3>@(Model?.AsEnumerable().Count(r => (Convert.ToDouble(r["ALINAN_SIPARIS_MIKTARI"]) -
                                                        Convert.ToDouble(r["VERILEN_SIPARIS_MIKTARI"])) > 0) ?? 0)</h3>
                                                        <small class="opacity-75">Mevcut ürünler</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="card border-0 shadow-lg fade-in-up stagger-4"
                                                style="background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);">
                                                <div class="card-body text-center text-white p-4">
                                                    <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                                                    <h5>Eksi Stok</h5>
                                                    <h3>@(Model?.AsEnumerable().Count(r => (Convert.ToDouble(r["ALINAN_SIPARIS_MIKTARI"]) -
                                                        Convert.ToDouble(r["VERILEN_SIPARIS_MIKTARI"])) < 0) ?? 0)</h3>
                                                        <small class="opacity-75">Dikkat gerekli</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="card border-0 shadow-lg fade-in-up stagger-4"
                                                style="background: linear-gradient(135deg, #64748b 0%, #94a3b8 100%);">
                                                <div class="card-body text-center text-white p-4">
                                                    <i class="fas fa-equals fa-3x mb-3"></i>
                                                    <h5>Sıfır Stok</h5>
                                                    <h3>@(Model?.AsEnumerable().Count(r => (Convert.ToDouble(r["ALINAN_SIPARIS_MIKTARI"]) -
                                                        Convert.ToDouble(r["VERILEN_SIPARIS_MIKTARI"])) == 0) ?? 0)</h3>
                                <small class="opacity-75">Tükenen ürünler</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-lg fade-in-up stagger-4"
                        style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <div class="card-body text-center text-white p-4">
                            <i class="fas fa-cubes fa-3x mb-3"></i>
                            <h5>Toplam Stok</h5>
                            <h3>@(Model?.Rows.Count ?? 0)</h3>
                            <small class="opacity-75">Stok kalemi</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 🎪 ANIMATION SCRIPT -->
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Animation Observer
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.style.animationPlayState = 'running';
                        }
                    });
                }, { threshold: 0.1 });

                // Observe all animated elements
                document.querySelectorAll('.fade-in, .fade-in-up, .slide-in, .rotate-in').forEach(el => {
                    el.style.animationPlayState = 'paused';
                    observer.observe(el);
                });

                // Add hover effects to table rows
                document.querySelectorAll('.stok-table tbody tr').forEach(row => {
                    row.addEventListener('mouseenter', function () {
                        this.style.transform = 'translateX(8px)';
                    });

                    row.addEventListener('mouseleave', function () {
                        this.style.transform = 'translateX(0)';
                    });
                });

                // Add interactive effects to cards
                document.querySelectorAll('.card').forEach(card => {
                    card.addEventListener('mouseenter', function () {
                        this.style.transform = 'translateY(-5px) scale(1.02)';
                    });

                    card.addEventListener('mouseleave', function () {
                        this.style.transform = 'translateY(0) scale(1)';
                    });
                });
            });

            // CSV Export Function
            function exportStokCsv(stokAd) {
                const btn = event.target;
                const originalText = btn.innerHTML;
                
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>İndiriliyor...';
                btn.disabled = true;
                
                fetch(`/PersonelStok/ExportStokCsv?stokad=${encodeURIComponent(stokAd)}`)
                    .then(response => {
                        if (response.ok) {
                            return response.blob();
                        }
                        throw new Error('Export failed');
                    })
                    .then(blob => {
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `stoklar_${stokAd}.csv`;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        window.URL.revokeObjectURL(url);
                        
                        showNotification('✅ Stok listesi başarıyla indirildi!', 'success');
                    })
                    .catch(error => {
                        console.error('Export error:', error);
                        showNotification('❌ CSV indirme hatası!', 'error');
                    })
                    .finally(() => {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    });
            }
        </script>
